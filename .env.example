# Copy to .env.local and fill in. Never commit .env.local.

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.allyouneedmovers.com

# ── Lead delivery ─────────────────────────────────────────────────────────────
# Every form — quote wizard, contact, careers — delivers through this one path.
# Subject lines look like:
#   AllYouNeedMovers — New quote request — AYN-260801-0493
#
# Pick ONE provider:
#   resend    — what this site uses. See setup below.
#   formspree — alternative; no sending domain required
#   console   — local development; logs the lead instead of sending it
LEAD_PROVIDER=resend

# Where new leads land. Comma-separate for multiple recipients.
# Defaults to outofstatemovers@gmail.com in code if this is left unset.
LEAD_TO_EMAIL=outofstatemovers@gmail.com

# ── Resend setup ──────────────────────────────────────────────────────────────
# 1. Create an account at resend.com using the inbox above.
# 2. Create an API key and paste it here.
RESEND_API_KEY=
#
# 3. LEAD_FROM_EMAIL is the *sender*. Resend will only send from a domain you
#    have verified — a Gmail address will NOT work here.
#
#    Leave it blank to start: the code falls back to Resend's shared test sender
#    (onboarding@resend.dev), which needs no DNS but will ONLY deliver to the
#    address that owns the Resend account. Good enough to prove the wiring.
#
#    Before launch, add your domain in Resend, complete the DNS records, then set
#    this to an address on it so mail reaches any inbox and lands in the inbox
#    rather than spam.
LEAD_FROM_EMAIL=

# ── Formspree (only if LEAD_PROVIDER=formspree) ───────────────────────────────
# Sign up at formspree.io with the inbox above, create a form, and paste the id
# from the endpoint it gives you (https://formspree.io/f/XXXXXXX).
FORMSPREE_FORM_ID=

# ── Spam protection (optional but recommended before launch) ──────────────────
# Cloudflare Turnstile. Leave blank to disable; the honeypot and timing checks
# still run either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Copy to .env.local and fill in. Never commit .env.local.

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.allyouneedmovers.com

# ── Lead delivery ─────────────────────────────────────────────────────────────
# Pick ONE provider. See src/lib/leads/README.md for the trade-offs.
#   resend   — transactional email, needs a verified sending domain
#   formspree — no domain setup, forwards to an inbox
#   console  — development default; logs the lead instead of sending it
LEAD_PROVIDER=console

# Required when LEAD_PROVIDER=resend
RESEND_API_KEY=
# Must be on a domain verified in Resend
LEAD_FROM_EMAIL=quotes@allyouneedmovers.com
# Where new leads land. Comma-separate for multiple recipients.
LEAD_TO_EMAIL=move@allyouneedmovers.com

# Required when LEAD_PROVIDER=formspree
# The form id from your Formspree endpoint (https://formspree.io/f/XXXXXXX)
FORMSPREE_FORM_ID=

# ── Spam protection (optional but recommended before launch) ──────────────────
# Cloudflare Turnstile. Leave blank to disable; the honeypot and timing checks
# still run either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
